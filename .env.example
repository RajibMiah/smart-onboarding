# Docker Compose configuration for the whole stack (mysql + backend + frontend).
# Copy this to `.env` (git-ignored) before running `docker compose up --build`.
# Not the same file as backend/.env or frontend/.env.local — those are for
# running the services natively, outside Docker.

# --- MySQL (read by the official mysql image) ---
MYSQL_DATABASE=smart_onboarding
MYSQL_USER=onboarding_user
MYSQL_PASSWORD=onboarding_pass
MYSQL_ROOT_PASSWORD=onboarding_root_pass

# --- Backend (Django) ---
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# DB_* must match the MYSQL_* values above; DB_HOST is the compose service
# name so the backend container can reach it over the Docker network.
DB_NAME=smart_onboarding
DB_USER=onboarding_user
DB_PASSWORD=onboarding_pass
DB_HOST=mysql
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
# Baked into the client bundle at build time, so it must be the backend's
# host-published URL (reachable from the browser), not the internal
# "backend" service name.
NEXT_PUBLIC_API_URL=http://localhost:8000
