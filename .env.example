# Docker Compose configuration for the whole stack (mysql + backend + frontend).
# Copy this to `.env` (git-ignored) before running `docker compose up --build`,
# then fill in every value below — see docs/configuration.md for what each
# one does and suggested local values. Not the same file as backend/.env or
# frontend/.env.local — those are for running the services natively.

# --- MySQL (read by the official mysql image) ---
MYSQL_DATABASE=""
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""

# --- Backend (Django) ---
DEBUG=""
SECRET_KEY=""
ALLOWED_HOSTS=""
# DB_* must match the MYSQL_* values above. DB_HOST is the Compose service
# name (e.g. "mysql") so the backend container can reach it over the Docker
# network — not 127.0.0.1.
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_HOST=""
DB_PORT=""
CORS_ALLOWED_ORIGINS=""
# AI Auto-Edit pipeline (studio/tasks.py, celery_worker service). REDIS_URL's
# default already matches the "redis" Compose service name; only override it
# if Redis lives somewhere else. AI_AUTO_EDIT_USE_MOCK=False requires a real
# Ollama instance reachable at OLLAMA_BASE_URL — leave True (the default)
# until one is actually running.
REDIS_URL=""
AI_AUTO_EDIT_USE_MOCK=""
OLLAMA_BASE_URL=""

# --- Frontend (Next.js) ---
# Baked into the client bundle at build time, so it must be the backend's
# host-published URL (reachable from the browser, e.g. http://localhost:8000)
# — not the internal "backend" service name.
NEXT_PUBLIC_API_URL=""
